# LingoSprout Environment Variables

# ─── Firebase (Parent Authentication) ──────────────────────────────────────
# Required for real login/registration. App works in demo mode without these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── AI Companion (Server-side only — do NOT prefix with VITE_) ────────────
# Used in TanStack Start server functions only. Never exposed to the browser.
OPENAI_API_KEY=
# or
GEMINI_API_KEY=

# ─── Speech Pronunciation Assessment (Server-side only) ───────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ─── App Configuration ─────────────────────────────────────────────────────
# Controls demo/production mode. Set to "true" to enable real integrations.
VITE_PRODUCTION_MODE=false
